{
  "name": "negocar-system",
  "version": "1.0.2",
  "description": "Sistema de gerenciamento para oficinas",
  "main": "electron.js",
  "scripts": {
    "start": ".\\node_modules\\.bin\\electron.cmd .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.seusistema.app",
    "productName": "CDDriver",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.17.1",
    "googleapis": "^144.0.0",
    "node-fetch": "^3.3.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^40.9.3",
    "electron-builder": "^26.8.1",
    "nodemon": "^2.0.15"
  }
}
